{
  "name": "floppy-clash",
  "version": "1.0.0",
  "private": true,
  "description": "Floppy Clash — a local couch physics brawler inspired by Stick Fight.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "server": "tsx server/signaling.ts",
    "ci": "npm run check"
  },
  "dependencies": {
    "@typegpu/noise": "0.12.0",
    "@typegpu/sdf": "0.12.0",
    "koota": "0.6.6",
    "planck": "1.5.0",
    "tweakpane": "4.0.5",
    "typegpu": "0.12.4",
    "ws": "8.18.3",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "@types/node": "22.18.6",
    "@types/ws": "8.18.1",
    "eslint": "9.36.0",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "unplugin-typegpu": "0.12.3",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
